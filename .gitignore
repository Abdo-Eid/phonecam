# --- Windows / C++ / Visual Studio / CMake ---
build/
out/
x64/
x86/
Debug/
Release/
*.obj
*.ilk
*.pdb
*.idb
*.exp
*.lib
*.dll
!third_party/**/*.lib
!third_party/**/*.dll
!third_party/**/*.sys
# third_party/libusbk-redist/dll/x86/ is a real vendored directory (32-bit
# DLLs libwdi's embedder requires even in an x64-only build), not a stray
# build-output x86/ folder -- the blanket x86/ ignore above would otherwise
# swallow it entirely, before the *.dll negation above even gets a chance.
!third_party/**/x86/
.vs/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
*.sln.docstates
*.vcxproj.user
windows/packages/
windows/vcam/x64/
windows/vcam/packages/
windows/installer/Output/

# --- Android / Gradle / Kotlin ---
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/*.iml
android/captures/
android/.cxx/
*.apk
*.aab

# --- Generated protocol code ---
proto/generated/

# --- Editors / OS ---
.idea/
.vscode/
*.user
Thumbs.db
.DS_Store

# --- Secrets / signing ---
*.keystore
*.jks
!debug.keystore
*.pfx
*.snk
